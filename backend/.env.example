# Copy to backend/.env and fill in values (backend/.env is gitignored).
# Full template with all required vars: see backend/env.example

# Site terrain — Esri World Imagery (free tier: https://location.arcgis.com)
ESRI_API_KEY=

# Optional: Mapbox alternate providers
# MAPBOX_ACCESS_TOKEN=

# Optional overrides (defaults: terrarium + esri-world-imagery)
# SITE_TERRAIN_ELEVATION_PROVIDER=terrarium
# SITE_TERRAIN_IMAGERY_PROVIDER=esri-world-imagery
