# Application
NODE_ENV=development
PORT=3000
TRUST_PROXY_DEPTH=0

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blulok_dev
DB_USER=blulok_user
DB_PASSWORD=blulok_password

# Security
# Generate secure values for local development:
# npm run gen:dev-secrets
JWT_SECRET=replace-with-generated-jwt-secret
# Optional: AES-256-GCM key for Twilio/SMTP secrets in system_settings (32+ chars or 64-hex)
# SETTINGS_ENCRYPTION_KEY=
JWT_EXPIRES_IN=30d
OPS_ED25519_PRIVATE_KEY_B64=replace-with-generated-ops-private-key
OPS_ED25519_PUBLIC_KEY_B64=replace-with-generated-ops-public-key
ROOT_ED25519_PUBLIC_KEY_B64=replace-with-generated-root-public-key
ROUTE_PASS_TTL_HOURS=24
FALLBACK_IAT_SKEW_SECONDS=10

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3002

# Logging
LOG_LEVEL=info

# Site terrain — Esri World Imagery (free tier: https://location.arcgis.com)
ESRI_API_KEY=

# Optional: Mapbox alternate providers
# MAPBOX_ACCESS_TOKEN=

# Optional overrides (defaults: terrarium + esri-world-imagery)
# SITE_TERRAIN_ELEVATION_PROVIDER=terrarium
# SITE_TERRAIN_IMAGERY_PROVIDER=esri-world-imagery

# Firmware OTA (optional — defaults shown)
# Transfer reconnect grace after gateway WS drop during chunk delivery (seconds).
# Default: same as FIRMWARE_VERIFY_DISCONNECT_GRACE_SEC (180). Set lower only for fast local E2E.
# FIRMWARE_TRANSFER_DISCONNECT_GRACE_SEC=180
# Grace while awaiting verify/reboot after all chunks sent (seconds). Default: 180
# FIRMWARE_VERIFY_DISCONNECT_GRACE_SEC=180
# FIRMWARE_VERIFY_TIMEOUT_SEC=900
# FIRMWARE_GATEWAY_VERIFY_TIMEOUT_SEC=300
