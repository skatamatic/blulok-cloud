# Application
NODE_ENV=development
PORT=3000
TRUST_PROXY_DEPTH=0

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blulok_dev
DB_USER=blulok_user
DB_PASSWORD=blulok_password

# Security
# Generate secure values for local development:
# npm run gen:dev-secrets
JWT_SECRET=replace-with-generated-jwt-secret
JWT_EXPIRES_IN=30d
OPS_ED25519_PRIVATE_KEY_B64=replace-with-generated-ops-private-key
OPS_ED25519_PUBLIC_KEY_B64=replace-with-generated-ops-public-key
ROOT_ED25519_PUBLIC_KEY_B64=replace-with-generated-root-public-key
ROUTE_PASS_TTL_HOURS=24
FALLBACK_IAT_SKEW_SECONDS=10

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Logging
LOG_LEVEL=info
