{
  "name": "blulok-backend",
  "version": "1.0.0",
  "description": "BluLok Cloud Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/dev-run.js",
    "dev:watch": "node --watch --watch-path=./src --watch-preserve-output scripts/dev-run.js",
    "build": "tsc && tsc-alias && node scripts/copy-build-assets.js",
    "start": "node dist/index.js",
    "test": "jest",
    "test:serial": "jest --maxWorkers=1",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:full": "jest --config jest.config.coverage-full.js --coverage --coverageReporters=text-summary",
    "test:coverage:areas": "jest --coverage --coverageReporters=json-summary --coverageReporters=text-summary --silent && node ../scripts/print-coverage-by-area.mjs backend",
    "test:coverage:areas:full": "jest --config jest.config.coverage-full.js --coverage --coverageReporters=json-summary --coverageReporters=text-summary --silent && node ../scripts/print-coverage-by-area.mjs backend",
    "test:security": "node scripts/run-security-tests.js",
    "test:security:watch": "jest --testPathPattern=security --watch",
    "test:security:coverage": "jest --testPathPattern=security --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "migrate": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "seed": "node scripts/seed-basic.js",
    "seed:test-data": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts --specific=004_comprehensive_test_data.ts",
    "seed:simple": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts --specific=005_simple_test_data.ts",
    "db:init": "node scripts/init-database.js",
    "db:setup": "npm run db:init && npm run migrate && npm run seed",
    "db:demo": "npm run db:init && npm run migrate && npm run seed:simple",
    "demo:reset": "node scripts/reset-demo-db.js",
    "gen:ops-keys": "node scripts/gen-ops-keys.js",
    "gen:root-keys": "node scripts/gen-root-keys.js",
    "gen:dev-secrets": "node scripts/gen-dev-secrets.js",
    "gen:public_keys": "node scripts/gen-public-keys.js",
    "ws:test": "node scripts/ws-gateway-test.js",
    "ws:e2e": "node scripts/ws-gateway-e2e.js",
    "ws:e2e:ztp": "node -e \"process.env.E2E_GATEWAY_AUTH='ztp';require('./scripts/ws-gateway-e2e.js')\"",
    "device-metadata:e2e": "node scripts/device-metadata-e2e.js",
    "storage:e2e": "node scripts/storage-e2e.js",
    "bludesign:detect": "node -r ts-node/register -r tsconfig-paths/register scripts/bludesign-detect.ts",
    "bludesign:detect:test": "jest --runTestsByPath src/bludesign/layout-import/__tests__/detectUnits.regression.test.ts --testPathIgnorePatterns /node_modules/",
    "terrain:fetch-harness": "node -r ts-node/register -r tsconfig-paths/register scripts/terrain-fetch-harness.ts",
    "openapi:generate": "node -r ts-node/register -r tsconfig-paths/register scripts/generate-openapi.ts",
    "openapi:audit": "node -r ts-node/register -r tsconfig-paths/register scripts/audit-openapi-coverage.ts",
    "openapi:check": "npm run openapi:generate -- --strict && npm run openapi:audit && git diff --exit-code openapi/generated.json"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.18.0",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@types/uuid": "^8.3.4",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "form-data": "^4.0.5",
    "googleapis": "^126.0.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jose": "^5.2.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^2.5.1",
    "multer": "^2.0.2",
    "mysql2": "^3.6.0",
    "oauth-1.0a": "^2.2.6",
    "sharp": "0.34.5",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "7.0.0",
    "twilio": "^4.22.0",
    "unzipper": "^0.12.3",
    "uuid": "^8.3.2",
    "winston": "^3.10.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.5.0",
    "@types/supertest": "^2.0.12",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "express-list-endpoints": "^7.1.1",
    "jest": "^29.6.2",
    "joi-to-swagger": "^6.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
