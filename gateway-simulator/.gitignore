# Dependencies
node_modules/

# electron-vite build output (see package.json "main": "./out/main/index.js")
out/
dist/
dist-electron/

# Packaged app artifacts (electron-builder / electron-forge, if added later)
release/
*.dmg
*.exe
*.AppImage
*.deb
*.rpm
*.snap

# Test & coverage
coverage/
.nyc_output/

# Environment & secrets (live API tests read DEV_ADMIN_* / API_BASE_URL)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / Vitest caches
.vite/
vitest.config.ts.timestamp-*

# TypeScript incremental build info
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE (personal workspace settings; root .gitignore also covers these)
.vscode/*
!.vscode/extensions.json
.idea/

# Local scratch / probes (keep scripts/ committed; ignore ad-hoc output)
*.tmp
*.temp
scratch/
local/
